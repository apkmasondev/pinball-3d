# Allow-list: only the game itself, the README and the Pages workflow are published.
/*
!/.gitignore
!/README.md
!/.github/
!/game/

# build output and dependencies
/game/node_modules/
/game/dist/

# editor / OS noise
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
.env
.env.*

# local development aids (notes, prompts, audit tools, layout tests) stay out of the public repo
/game/*.md
/game/tests/
/game/tools/
